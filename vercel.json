{
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "admin.haysohealth.com" }], "destination": "/admin/index.html" }
  ],
  "headers": [
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "X-Frame-Options", "value": "DENY" }] }
  ]
}
